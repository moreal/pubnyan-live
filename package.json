{
  "name": "pubnyan-live",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#ir/*": "./packages/ir/src/*",
    "#rig-extract/*": "./packages/rig-extract/src/*",
    "#export-svg/*": "./packages/export-svg/src/*",
    "#export-lottie/*": "./packages/export-lottie/src/*",
    "#export-rive/*": "./packages/export-rive/src/*",
    "#verify/*": "./packages/verify/src/*",
    "#motion/*": "./motion/*",
    "#rig/*": "./rig/*"
  },
  "scripts": {
    "test": "vitest run",
    "check:types": "tsc --noEmit",
    "rig:extract": "node packages/rig-extract/src/cli.ts extract",
    "rig:inspect": "node packages/rig-extract/src/cli.ts inspect",
    "export:svg": "node packages/export-svg/src/cli.ts",
    "export:lottie": "node packages/export-lottie/src/cli.ts",
    "export:rive": "node packages/export-rive/src/cli.ts",
    "verify": "node packages/verify/src/cli.ts",
    "check": "npm run check:types && npm test && npm run verify",
    "agent": "node scripts/agent-loop.mjs"
  },
  "dependencies": {
    "@flue/runtime": "^2.0.3",
    "@lottiefiles/dotlottie-web": "^0.80.0",
    "@rive-app/canvas": "^2.42.0",
    "@xmldom/xmldom": "^0.9.12",
    "lottie-web": "^5.13.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.10.0",
    "svg-path-bbox": "^2.1.0",
    "svgpath": "^2.6.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@flue/cli": "^2.0.3",
    "@types/node": "^26.4.1",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "core-js-pure@3.50.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "puppeteer@25.10.0": true,
    "fsevents@2.3.3": true
  }
}
